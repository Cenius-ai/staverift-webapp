# StaveRift has no secrets and needs no configuration to run.
#
# Exactly one environment variable is honoured, and it is read straight from the
# process environment -- StaveRift does not load a .env file, so `cp .env.example
# .env` changes nothing. Export the value in your shell instead:
#
#   export STAVERIFT_STORE="/home/cooper/shop-a.json"
#
# Store path precedence: --store PATH > $STAVERIFT_STORE > ~/.staverift/store.json
# Leave it empty (the default here) to use ~/.staverift/store.json.
STAVERIFT_STORE=
